<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <title>{% if meetup_name %}{{ meetup_name }}{% else %}Teilnehmendenkontaktliste{% endif %}</title>
  <style>
    @page {
      size: A4;
      margin: 1.2cm;
    }
    body {
      font-family: Helvetica, Arial, sans-serif;
      font-size: 11pt;
      line-height: 1.4;
      margin: 0;
      padding: 0;
      color: #1a1a1a;
    }
    h1 {
      font-size: 16pt;
      margin: 0 0 10pt 0;
      font-weight: bold;
    }
    table.columns {
      width: 100%;
    }
    td.card-cell {
      width: 48%;
      vertical-align: top;
      border: 1px solid #404040;
      padding: 6pt 7pt;
    }
    td.card-cell-empty {
      width: 48%;
      border: none;
      padding: 0;
    }
    td.col-gap {
      width: 4%;
      border: none;
      padding: 0;
    }
    tr.row-gap td {
      height: 8pt;
      border: none;
      padding: 0;
      font-size: 1pt;
      line-height: 1pt;
    }
    table.card-inner {
      width: 100%;
    }
    td.card-photo-cell {
      width: 72px;
      vertical-align: top;
      padding: 0 5pt 0 0;
    }
    td.card-body-cell {
      vertical-align: top;
      padding: 0;
    }
    img.card-photo {
      width: 72px;
      height: 72px;
    }
    .card-body p {
      margin: 2pt 0;
      font-size: 10pt;
    }
    .card-body .label {
      font-weight: bold;
      color: #333;
    }
  </style>
</head>
<body>
  <h1>{% if meetup_name %}{{ meetup_name }}{% else %}Teilnehmendenkontaktliste{% endif %}</h1>
  <table class="columns">
    {% for p in participants %}
      {% if loop.index0 % 2 == 0 %}
      <tr>
      {% endif %}
        <td class="card-cell">
          <table class="card-inner">
            <tr>
              <td class="card-photo-cell">
                {% if p.image_data %}
                <img class="card-photo" src="{{ p.image_data }}" alt="" width="72" height="72">
                {% endif %}
              </td>
              <td class="card-body-cell">
                <div class="card-body">
                  <p><span class="label">Name:</span> {{ [p.vorname if (p.vorname is defined and p.vorname) else none, p.rufname if p.rufname else none, p.nachname if (p.nachname is defined and p.nachname) else none] | select | join(' ') }}</p>
                  <p><span class="label">Ort:</span> {{ p.land }}{% if p.plz %}, {{ p.plz }}{% endif %}{% if p.ort %} {{ p.ort }}{% endif %}</p>
                  {% if p.couch %}<p><span class="label">Couch:</span> {{ p.couch }}</p>{% endif %}
                  {% if p.email is defined and p.email %}<p><span class="label">E-Mail:</span> <a href="mailto:{{ p.email }}">{{ p.email }}</a></p>{% endif %}
                  {% if p.phone is defined and p.phone %}<p><span class="label">Telefon:</span> <a href="tel:{{ p.phone }}">{{ p.phone }}</a></p>{% endif %}
                </div>
              </td>
            </tr>
          </table>
        </td>
      {% if loop.index0 % 2 == 0 %}
        <td class="col-gap">&nbsp;</td>
      {% endif %}
      {% if loop.index0 % 2 == 1 or loop.last %}
        {% if loop.index0 % 2 == 0 %}
        <td class="card-cell-empty"></td>
        {% endif %}
      </tr>
        {% if not loop.last %}
      <tr class="row-gap"><td colspan="3">&nbsp;</td></tr>
        {% endif %}
      {% endif %}
    {% endfor %}
  </table>
</body>
</html>
